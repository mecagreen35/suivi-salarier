      "allowSameOptionsInNewRow": true,
      "buttonStyle": "rgb(3, 179, 101)",
      "columnType": "text",
      "computedValue": "{{(() => { const tableData = Table2.processedTableData || []; return tableData.length > 0 ? tableData.map((currentRow, currentIndex) => (\n  currentRow.type_demande === 'ABSENCE'\n    ? `${currentRow.type_absence || ''} (${currentRow.periode_absence || 'JOURNEE'})` + (currentRow.commentaire_salarie ? ' — ' + currentRow.commentaire_salarie : '')\n    : [\n        currentRow.heure_matin ? 'Arr : ' + currentRow.heure_matin.slice(0, 5) : '',\n        currentRow.heure_deb_pause ? 'Pause : ' + currentRow.heure_deb_pause.slice(0, 5) : '',\n        currentRow.heure_fin_pause ? 'Retour : ' + currentRow.heure_fin_pause.slice(0, 5) : '',\n        currentRow.heure_soir ? 'Dép : ' + currentRow.heure_soir.slice(0, 5) : '',\n        currentRow.commentaire_salarie ? '(' + currentRow.commentaire_salarie + ')' : ''\n      ].filter(Boolean).join(' | ')\n)) : \n  currentRow.type_demande === 'ABSENCE'\n    ? `${currentRow.type_absence || ''} (${currentRow.periode_absence || 'JOURNEE'})` + (currentRow.commentaire_salarie ? ' — ' + currentRow.commentaire_salarie : '')\n    : [\n        currentRow.heure_matin ? 'Arr : ' + currentRow.heure_matin.slice(0, 5) : '',\n        currentRow.heure_deb_pause ? 'Pause : ' + currentRow.heure_deb_pause.slice(0, 5) : '',\n        currentRow.heure_fin_pause ? 'Retour : ' + currentRow.heure_fin_pause.slice(0, 5) : '',\n        currentRow.heure_soir ? 'Dép : ' + currentRow.heure_soir.slice(0, 5) : '',\n        currentRow.commentaire_salarie ? '(' + currentRow.commentaire_salarie + ')' : ''\n      ].filter(Boolean).join(' | ')\n })()}}",
